[Unit]
Description=RPi Router Management API
After=network.target parental-control.service
Requires=parental-control.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/rpi-router-api
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/gunicorn --workers 2 --threads 2 --bind 0.0.0.0:8080 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
